{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shi1720/agent-rehearsal/main/schema/trace.schema.json",
  "title": "Agent Rehearsal trace v1",
  "description": "Metadata-only trace. Application additionally enforces unique event IDs and maximum UTF-8 file size of 2 MiB. Unknown properties are discarded on import.",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "source",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "source": {
      "enum": [
        "python-sdk",
        "manual"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tool",
          "kind",
          "attempt",
          "startMs",
          "durationMs",
          "status",
          "fault",
          "effect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "kind": {
            "enum": [
              "read",
              "write"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "startMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "durationMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "cancelled",
              "injected"
            ]
          },
          "fault": {
            "enum": [
              "none",
              "rate_limit",
              "timeout_before",
              "timeout_after_write",
              "malformed",
              "permanent"
            ]
          },
          "effect": {
            "enum": [
              "none",
              "unknown",
              "committed"
            ]
          },
          "errorType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\u0000-\\u001f]+$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
